generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String    @id @default(cuid())
  shop      String
  title     String
  status    String
  vendor    String?
  image     String?
  createdAt DateTime  @default(now())
  variants  Variant[]

  @@unique([shop, id], name: "shop_id")
}

model Variant {
  id        String  @id @default(cuid())
  shopifyId String  @unique
  title     String
  price     Float
  sku       String?
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  accessToken         String    @default("")
  scope               String?
  expires             DateTime?
  accountOwner        Boolean   @default(false)
  collaborator        Boolean   @default(false)
  email               String?
  emailVerified       Boolean   @default(false)
  firstName           String?
  lastName            String?
  locale              String?
  refreshToken        String?
  refreshTokenExpires DateTime?
  userId              BigInt?

  @@map("session")
}

model VariantRollup {
  shop           String
  productId      String

  variantCount   Int
  totalInventory Int
  minPrice       Decimal?
  maxPrice       Decimal?
  inStock        Boolean
  updatedAt      DateTime @updatedAt

  @@id([shop, productId])
  @@index([shop, totalInventory])
  @@index([shop, minPrice])
  @@index([shop, maxPrice])
  @@index([shop, inStock])
}
