generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String    @id @default(cuid())
  shop      String
  title     String
  status    String
  vendor    String?
  image     String?
  createdAt DateTime  @default(now())
  variants  Variant[]

  @@unique([shop, id], name: "shop_id") // 👈 NAME IT
}


model Variant {
  id        String  @id @default(cuid())
  shopifyId String  @unique
  title     String
  price     Float
  sku       String?
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Session {
  id                  String   @id
  shop                String
  state               String
  isOnline            Boolean  @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String   @default("")
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean  @default(false)
  locale              String?
  collaborator        Boolean  @default(false)
  emailVerified       Boolean  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@map("session") // ✅ REQUIRED
}
